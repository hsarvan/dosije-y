# Claude API ključ (https://platform.claude.com) — obavezno za pravu analizu.
ANTHROPIC_API_KEY=sk-ant-...

# Mjesečni limit potrošnje u USD. Kad se dostigne, app odbija nove analize. 0 = bez limita.
MONTHLY_BUDGET_USD=25

# Koliko sati se istraženi podaci (dosije) ponovo koriste za isti upit bez nove pretrage weba.
DOSSIER_TTL_HOURS=12

# Server
PORT=3000
# 127.0.0.1 = samo ovaj računar. 0.0.0.0 = dostupno i s telefona u istoj mreži (tada postavi APP_PASSWORD).
HOST=127.0.0.1
# Ako je postavljeno, browser traži lozinku (korisničko ime može biti bilo šta).
APP_PASSWORD=

# DEMO=1 pokreće app bez API ključa s izmišljenim podacima (za probu izgleda).
DEMO=
